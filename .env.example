# ─────────────────────────────────────────────────────────────────
# CyberSource REST API credentials (HTTP Signature authentication)
# ─────────────────────────────────────────────────────────────────
# These authenticate your SERVER-TO-SERVER call to the Sessions API.
# They are NOT transaction keys and are NOT sent to the browser.
#
# How to get them (test environment):
#   1. Log in to https://businesscentertest.cybersource.com/ebc2
#   2. Go to: Payment Configuration > Key Management
#   3. Click "Generate Key" and choose "REST - Shared Secret"
#   4. Copy the Key ID and Shared Secret shown (secret is only shown once)
#
# Note: Do NOT use "Transaction Security Keys" (legacy SOAP API).
#       This project uses the REST API only.
# ─────────────────────────────────────────────────────────────────

MERCHANT_ID=your_merchant_id_here
KEY_ID=your_key_id_here
SHARED_SECRET=your_shared_secret_here

# Server
PORT=3000

# CyberSource requires an HTTPS origin in targetOrigins.
# For local dev, use ngrok: `npx ngrok http 3000`
# Then set ORIGIN_URL to the https://xxxx.ngrok.io URL it gives you.
# If unset, falls back to http://localhost:PORT (will fail targetOrigins validation).
ORIGIN_URL=https://xxxx.ngrok.io
